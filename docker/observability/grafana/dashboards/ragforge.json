{
  "uid": "ragforge-overview",
  "title": "RAGForge",
  "description": "ADR-0018 §6: answers, models, retrieval & jobs, freshness & health. Catalogue metrics only (observability/catalog.py).",
  "tags": [
    "ragforge"
  ],
  "editable": false,
  "graphTooltip": 1,
  "timezone": "browser",
  "refresh": "1m",
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "type": "link",
      "title": "All alert rules",
      "tooltip": "Grafana Alerting > Alert rules: the Prometheus rules and their state, if the Alerts panel is empty",
      "url": "/alerting/list",
      "icon": "bell",
      "targetBlank": false,
      "asDropdown": false,
      "includeVars": false,
      "keepTime": false,
      "tags": []
    }
  ],
  "templating": {
    "list": [
      {
        "type": "custom",
        "name": "surface",
        "label": "Surface",
        "description": "chat is the owner; eval and demo traffic stays out of the owner's signals.",
        "query": "chat,interview,eval,demo,other",
        "multi": true,
        "includeAll": false,
        "current": {
          "text": [
            "chat"
          ],
          "value": [
            "chat"
          ]
        },
        "options": [
          {
            "text": "chat",
            "value": "chat",
            "selected": true
          },
          {
            "text": "interview",
            "value": "interview",
            "selected": false
          },
          {
            "text": "eval",
            "value": "eval",
            "selected": false
          },
          {
            "text": "demo",
            "value": "demo",
            "selected": false
          },
          {
            "text": "other",
            "value": "other",
            "selected": false
          }
        ]
      },
      {
        "type": "custom",
        "name": "window",
        "label": "Window",
        "description": "Rate/increase window. At one user, short windows are mostly empty.",
        "query": "15m,1h,6h,24h",
        "multi": false,
        "includeAll": false,
        "current": {
          "text": "1h",
          "value": "1h"
        },
        "options": [
          {
            "text": "15m",
            "value": "15m",
            "selected": false
          },
          {
            "text": "1h",
            "value": "1h",
            "selected": true
          },
          {
            "text": "6h",
            "value": "6h",
            "selected": false
          },
          {
            "text": "24h",
            "value": "24h",
            "selected": false
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "Answers",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 2,
      "title": "Chat time to first token (p50 / p95)",
      "description": "Owner surface by default (the surface variable). Wide windows: at one user a 5 min p95 is mostly empty.",
      "datasource": {
        "type": "prometheus",
        "uid": "ragforge-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ragforge-prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le, provider) (rate(ragforge_chat_time_to_first_token_seconds_bucket{surface=~\"$surface\"}[$window])))",
          "legendFormat": "p50 {{provider}}",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "ragforge-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, provider) (rate(ragforge_chat_time_to_first_token_seconds_bucket{surface=~\"$surface\"}[$window])))",
          "legendFormat": "p95 {{provider}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "id": 3,
      "title": "Chat turn duration (p50 / p95)",
      "description": "SLO lines: hosted 5 s, local 12 s (DESIGN §2). The alerts use the exact share over the bucket edge, not this interpolated quantile.",
      "datasource": {
        "type": "prometheus",
        "uid": "ragforge-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ragforge-prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le, provider) (rate(ragforge_chat_turn_duration_seconds_bucket{surface=~\"$surface\"}[$window])))",
          "legendFormat": "p50 {{provider}}",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "ragforge-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, provider) (rate(ragforge_chat_turn_duration_seconds_bucket{surface=~\"$surface\"}[$window])))",
          "legendFormat": "p95 {{provider}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 5
              },
              {
                "color": "red",
                "value": 12
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "id": 4,
      "title": "Turns by outcome",
      "description": "answered / abstained / refused / error / interrupted, per window.",
      "datasource": {
        "type": "prometheus",
        "uid": "ragforge-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ragforge-prometheus"
          },
          "expr": "sum by (outcome) (increase(ragforge_chat_turns_total{surface=~\"$surface\"}[$window]))",
          "legendFormat": "{{outcome}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "piechart",
      "id": 5,
      "title": "Verification mix (time range)",
      "description": "Verdicts of ANSWERED turns only (abstain, refusal and error excluded).",
      "datasource": {
        "type": "prometheus",
        "uid": "ragforge-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ragforge-prometheus"
          },
          "expr": "sum by (status) (increase(ragforge_verification_total{surface=~\"$surface\"}[$__range]))",
          "legendFormat": "{{status}}",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value",
            "percent"
          ]
        },
        "pieType": "donut"
      }
    },
    {
      "type": "stat",
      "id": 6,
      "title": "Verified share (time range)",
      "description": "Alert: under 50% over 6 h with at least 30 answered owner turns.",
      "datasource": {
        "type": "prometheus",
        "uid": "ragforge-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 6,
        "y": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ragforge-prometheus"
          },
          "expr": "(sum(increase(ragforge_verification_total{surface=~\"$surface\", status=\"verified\"}[$__range])) or vector(0)) / sum(increase(ragforge_verification_total{surface=~\"$surface\"}[$__range]))",
          "legendFormat": "verified",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "green",
                "value": 0.7
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "id": 7,
      "title": "Flagged claims by reason",
      "description": "Claims the citation check flagged: not_found (no supporting chunk) or inexact_code.",
      "datasource": {
        "type": "prometheus",
        "uid": "ragforge-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 10,
        "x": 10,
        "y": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ragforge-prometheus"
          },
          "expr": "sum by (reason) (increase(ragforge_flagged_claims_total{surface=~\"$surface\"}[$window]))",
          "legendFormat": "{{reason}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "stat",
      "id": 8,
