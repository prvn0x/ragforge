# Generated for you by `make env` (scripts/bootstrap.sh) with random secrets.
# Copy only if you need to set values by hand. Never commit .env.

RAGFORGE_DB_SUPERUSER_PASSWORD=
RAGFORGE_DB_MIGRATOR_PASSWORD=
RAGFORGE_DB_API_PASSWORD=
RAGFORGE_DB_WORKER_PASSWORD=
RAGFORGE_DB_METRICS_PASSWORD=
RAGFORGE_DB_BACKUP_PASSWORD=
RAGFORGE_KEK=

RAGFORGE_LOG_LEVEL=INFO

# host = native Ollama on macOS (Metal); container = compose profile "ollama"
RAGFORGE_OLLAMA_MODE=host
RAGFORGE_OLLAMA_BASE_URL=http://host.docker.internal:11434
RAGFORGE_CHAT_MODEL=llama3.2:3b
RAGFORGE_EMBED_MODEL=nomic-embed-text

# Chat model provider: `make setup` writes these (key read as hidden input). Unset = ollama, and
# while RAGFORGE_LLM_PROVIDER is unset the first `make up` in a terminal asks you, so keep it
# commented here. gemini sends each question and the retrieved note snippets to Google (free tier:
# may be used to improve Google products; paid tier: not). Embeddings always stay on local Ollama.
# Get a key at https://aistudio.google.com/apikey and never commit it.
# RAGFORGE_LLM_PROVIDER=ollama   # or gemini
# RAGFORGE_GEMINI_API_KEY=
# RAGFORGE_GEMINI_MODEL=gemini-3.5-flash-lite
# RAGFORGE_GEMINI_THINKING_BUDGET=0   # -1..32768; 0 = thinking off (fastest); Pro models reject 0 (use -1)

# ADR-0017 eval surface (/v1/eval). compose turns it on for the dev stack; set false to hide it.
# RAGFORGE_EVAL_API=false

# Grafana admin password for `make obs-up` (user: admin). Generated by `make env`.
RAGFORGE_GRAFANA_ADMIN_PASSWORD=
